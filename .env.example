# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables. Never commit real keys.

# ---- Site ----
NEXT_PUBLIC_SITE_NAME="BoardPrep Papers"
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_PHONE="+91 00000 00000"
NEXT_PUBLIC_BUSINESS_NAME="Your Business Name"
NEXT_PUBLIC_BUSINESS_ADDRESS="Registered address, City, State, PIN"

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that get the /admin panel
ADMIN_EMAILS=you@example.com

# Set to "true" after enabling Google in Supabase → Authentication → Providers
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# ---- Razorpay (Dashboard → Account & Settings → API Keys) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret you choose for https://<your-domain>/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- Cashfree (Payment Gateway dashboard → Developers → API Keys) ----
# When CASHFREE_APP_ID and CASHFREE_SECRET_KEY are set, the shop uses Cashfree instead of Razorpay.
# Force one with PAYMENT_PROVIDER=cashfree or PAYMENT_PROVIDER=razorpay.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "sandbox" with TEST keys, "production" with LIVE keys
CASHFREE_ENV=sandbox
# PAYMENT_PROVIDER=cashfree
